{
  "name": "@archon/overseer",
  "version": "0.1.0",
  "description": "Cauldron workflow-failure decision layer. Ports load-bearing slice of overlord/router.py (BDC) to TypeScript. Skeleton: error classification + retry decisions. Future: provider failover, grader integration.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./classify": "./src/classify.ts",
    "./decide": "./src/decide.ts",
    "./watch": "./src/watch.ts",
    "./judge-pr": "./src/judge-pr.ts",
    "./judge-second-opinion": "./src/judge-second-opinion.ts",
    "./merge-coordinator": "./src/merge-coordinator.ts",
    "./merge-manager": "./src/merge-manager.ts",
    "./service": "./src/service.ts",
    "./m31-substrate": "./src/m31-substrate.ts",
    "./action-policy": "./src/action-policy.ts",
    "./authorized-escalation": "./src/authorized-escalation.ts",
    "./permit": "./src/permit.ts",
    "./operator-card": "./src/operator-card.ts",
    "./escalation-delivery": "./src/escalation-delivery.ts",
    "./adapters/fake-github": "./src/adapters/fake-github.ts",
    "./adapters/github-qualified-merge": "./src/adapters/github-qualified-merge.ts",
    "./integration-manifest": "./src/integration-manifest.ts",
    "./independent-review-evidence": "./src/independent-review-evidence.ts",
    "./external-finalization": "./src/external-finalization.ts",
    "./integration-scenarios": "./src/integration-scenarios.ts",
    "./integration-fixtures": "./src/integration-fixtures.ts",
    "./activation-package": "./src/activation-package.ts",
    "./control-plane": "./src/control-plane.ts",
    "./m42-slice8b-manifest": "./src/m42-slice8b-manifest.ts",
    "./m42-slice8b-canary-runner": "./src/m42-slice8b-canary-runner.ts",
    "./staging-refire-bridge": "./src/staging-refire-bridge.ts",
    "./m42-slice8b-process-health": "./src/m42-slice8b-process-health.ts",
    "./m42-slice8b-gate1": "./src/m42-slice8b-gate1.ts",
    "./m42-slice8b-evidence-packet": "./src/m42-slice8b-evidence-packet.ts",
    "./taskmaster-deadman-check": "./src/taskmaster-deadman-check.ts"
  },
  "scripts": {
    "test": "bun test src/overseer.test.ts && bun test src/watch.test.ts && bun test tests/ && bun test src/__tests__/",
    "overseer:serve": "bun src/service.ts",
    "m42-slice8b:canary-run": "bun src/m42-slice8b-canary-runner.ts",
    "type-check": "bun x --bun tsc --noEmit"
  },
  "dependencies": {
    "@archon/core": "workspace:*",
    "@archon/fusion": "workspace:*",
    "@archon/workflows": "workspace:*",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.0",
    "@archon/paths": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  }
}
