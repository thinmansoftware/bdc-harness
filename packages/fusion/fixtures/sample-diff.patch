+/**
+ * format.ts -- Currency formatting utilities
+ */
+
+/**
+ * formatCurrency -- format a number as USD currency string.
+ *
+ * Returns ASCII-only output (no Unicode currency symbols that could break tooling).
+ *
+ * Examples:
+ *   formatCurrency(9.99)  => "$9.99"
+ *   formatCurrency(0)     => "$0.00"
+ *   formatCurrency(-1.00) => "-$1.00"
+ */
+export function formatCurrency(amount: number): string {
+  const abs = Math.abs(amount);
+  const formatted = abs.toFixed(2);
+  const sign = amount < 0 ? '-' : '';
+  return sign + '$' + formatted;
+}
