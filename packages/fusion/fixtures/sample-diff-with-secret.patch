+/**
+ * format.ts -- Currency formatting utilities
+ * WARNING: This file accidentally contains a hardcoded credential (test fixture).
+ */
+
+// BAD: hardcoded API key -- should never be in source
+const API_KEY = 'sk-abcdefghijklmnopqrstuvwxyz12345678901234';
+
+// BAD: hardcoded JWT token
+const AUTH_TOKEN = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c';
+
+/**
+ * formatCurrency -- format a number as USD currency string.
+ */
+export function formatCurrency(amount: number): string {
+  const abs = Math.abs(amount);
+  const formatted = abs.toFixed(2);
+  const sign = amount < 0 ? '-' : '';
+  return sign + '$' + formatted;
+}
