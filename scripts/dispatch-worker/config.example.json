{
  "worker_id": "dispatch-worker-localhost",
  "host": "localhost",
  "server_url": "http://localhost:3090",
  "operator_token_env": "ARCHON_OPERATOR_TOKEN",
  "poll_interval_ms": 5000,
  "heartbeat_interval_ms": 30000,
  "lease_duration_ms": 300000,
  "capabilities": {
    "providers": ["claude", "codex"],
    "docker": false,
    "browser": false
  },
  "max_concurrency": {
    "claude": 1,
    "codex": 1
  },
  "agents": {
    "claude": {
      "command": "claude",
      "args": ["-p", "{{prompt}}"]
    },
    "codex": {
      "command": "codex",
      "args": ["exec", "--skip-git-repo-check", "{{prompt}}"]
    }
  }
}
