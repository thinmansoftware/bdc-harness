# =============================================================================
# Cauldron STAGING env -- template (WO-HARNESS-CAULDRON-LAPTOP-STAGING-01)
# =============================================================================
# Copy to .env.staging (gitignored) and fill values. Rule 6: the real file must
# NEVER be committed. Placeholder NAMES only in this example.
#
# staging-up.ps1 will create .env.staging from this template on first run,
# auto-generating a fresh random ARCHON_OPERATOR_TOKEN and filling GITHUB_TOKEN
# from `gh auth token` if available.

# --- Operator API protection (REQUIRED) --------------------------------------
# MUST be a fresh random value, DISTINCT from the prod token on Hetzner.
# Generate: openssl rand -hex 32   (staging-up.ps1 does this automatically)
ARCHON_OPERATOR_TOKEN=REPLACE_WITH_FRESH_RANDOM_HEX_NEVER_THE_PROD_VALUE

# --- GitHub auth (REQUIRED for codebase clone + canary fires) -----------------
# Choice documented per WO section 5.1: staging reuses the CI token IDENTITY
# (same GitHub account as local `gh auth token`) but the value lives only in
# the gitignored .env.staging. Canary branches/PRs pushed from staging are
# therefore attributable to the same identity as laptop CLI work.
GITHUB_TOKEN=REPLACE_WITH_GH_AUTH_TOKEN
GH_TOKEN=

# --- AI provider -------------------------------------------------------------
# Staging uses global Claude auth read from /home/appuser/.claude inside the
# container (bind: ./staging-user-home). staging-up.ps1 offers to copy the
# laptop's ~/.claude/.credentials.json into staging-user-home/.claude/ so the
# canary's read-spec node can run a Claude provider. Local files only.
CLAUDE_USE_GLOBAL_AUTH=true
DEFAULT_AI_ASSISTANT=claude

# --- Instance identity / misc -------------------------------------------------
# There is no first-class STAGING flag in the codebase (verified 2026-07-10:
# no such env is read by packages/*). Isolation is port 3091 + own db + own
# volumes + own token. STAGING=1 is set anyway as a human/log marker.
STAGING=1
LOG_LEVEL=info
MAX_CONCURRENT_CONVERSATIONS=2

# --- Overseer safety gates (M-42 Slice 1 -- WO-HARNESS-OVERSEER-SAFETY-GATES-STAGING-01) ---
# Staging defaults: fail-closed. No live capability may be enabled here.
# The fake GitHub mutation adapter is required for all staging runs.
OVERSEER_ENABLED=false
OVERSEER_EMERGENCY_STOP=true
OVERSEER_DRY_RUN=true
OVERSEER_USE_FAKE_GITHUB_ADAPTER=1
OVERSEER_FAKE_GITHUB_REPOSITORIES=thinmansoftware/bdc-harness
OVERSEER_ESCALATION_ACTIONS_ENABLED=false
OVERSEER_REPAIR_ACTIONS_ENABLED=false
OVERSEER_BRANCH_ACTIONS_ENABLED=false
OVERSEER_LIFECYCLE_ACTIONS_ENABLED=false
OVERSEER_MERGE_ACTIONS_ENABLED=false

# --- DELIBERATELY ABSENT (WO section 6 -- do NOT add) --------------------------
# TELEGRAM_BOT_TOKEN         (no Telegram on staging)
# DISCORD_BOT_TOKEN / SLACK_BOT_TOKEN / SLACK_APP_TOKEN
# NOTION_API_KEY / NOTION_DB_ID          (no Notion writes from staging)
# BUILDER_MONITOR_WEBHOOK_URL            (no n8n from staging)
# DATABASE_URL                           (SQLite only -- own event store)
# HETZNER_SSH_KEY_B64 / CF_ACCESS_*      (no prod creds of any kind)
