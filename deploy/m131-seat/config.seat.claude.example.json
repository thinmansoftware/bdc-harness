{
  "worker_id": "bdc-seat-claude",
  "host": "bdc-seat-claude",
  "server_url": "http://archon-app-1:3090",
  "operator_token_env": "ARCHON_OPERATOR_TOKEN",
  "operator_token_file": "/run/m131/operator-token/archon-operator-token",
  "poll_interval_ms": 5000,
  "heartbeat_interval_ms": 30000,
  "lease_duration_ms": 300000,
  "max_concurrency": {
    "claude": 1
  },
  "seat": {
    "seat_id": "bdc-seat-claude",
    "model_family": "claude",
    "provider_allowlist": ["claude"],
    "secret_ingress_file": "/run/m131/secret-ingress/claude-credential.json",
    "vendor_profile_dir": "/home/seat/.claude",
    "state_dir": "/var/lib/bdc-seat",
    "build_sha_env": "SEAT_BUILD_SHA"
  }
}
